{
  "name": "nexus-lending-protocol",
  "version": "1.0.0",
  "private": true,
  "description": "Secure Decentralized P2P Fixed-Rate Isolated Lending Marketplace on Stellar Soroban",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build && npm --prefix backend run build",
    "lint": "npm --prefix frontend run lint",
    "test": "npm --prefix backend test"
  },
  "dependencies": {
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^16.0.1"
  },
  "devDependencies": {
    "typescript": "~6.0.2"
  },
  "keywords": [
    "stellar",
    "soroban",
    "lending-protocol",
    "p2p-lending",
    "smart-contracts",
    "rust",
    "react",
    "typescript"
  ],
  "author": "Nexus Team",
  "license": "MIT"
}
